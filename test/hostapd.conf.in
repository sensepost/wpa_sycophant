interface=@INTERFACE@
driver=nl80211
ctrl_interface=@CTRL_INTERFACE@

ssid=TestingEAP
hw_mode=g
channel=1
auth_algs=1

wpa=2
wpa_key_mgmt=WPA-EAP
rsn_pairwise=CCMP
ieee8021x=1
eap_server=1
eap_user_file=@EAP_USER_FILE@
ca_cert=@CA_CERT@
server_cert=@SERVER_CERT@
private_key=@PRIVATE_KEY@

@MANA_OPTIONS@
